{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rayesh.company/schemas/workflow-v1.json",
  "title": "Rayesh Workflow v1",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "nodes"
  ],
  "properties": {
    "apiVersion": {
      "const": "rayesh.io/v1"
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "intent": {
      "type": "object",
      "properties": {
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "type",
          "acceptance"
        ],
        "properties": {
          "type": {
            "enum": [
              "agent",
              "foreach",
              "gate",
              "human",
              "workflow"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "task": {
            "type": "string"
          },
          "workspace": {
            "enum": [
              "readonly",
              "worktree",
              "shared"
            ]
          },
          "acceptance": {
            "type": "object",
            "required": [
              "criteria"
            ],
            "properties": {
              "criteria": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
